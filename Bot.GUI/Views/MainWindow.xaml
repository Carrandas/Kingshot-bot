<Window x:Class="Bot.GUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bot.GUI"
        xmlns:views="clr-namespace:Bot.GUI.Views"
        xmlns:converters="clr-namespace:Bot.GUI.Converters"
        mc:Ignorable="d"
        Title="{Binding Version, StringFormat=KingshotAuto v{0}}"
        Height="800" Width="1200"
        MinWidth="1000" MinHeight="700"
        Background="#FF1E1E1E"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Converters -->
        <converters:ShieldTimeToColorConverter x:Key="ShieldTimeToColorConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>

        <!-- Modern Color Brushes -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF0D7377" Offset="0"/>
            <GradientStop Color="#FF14A085" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4CAF50" Offset="0"/>
            <GradientStop Color="#FF66BB6A" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFD32F2F" Offset="0"/>
            <GradientStop Color="#FFE57373" Offset="1"/>
        </LinearGradientBrush>

        <!-- Modern Button Style for Sidebar -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFB0B0B0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Margin="10,2">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3A3A3A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Active Tab Button Style -->
        <Style x:Key="ActiveSidebarButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        
        <!-- Modern Card Style -->
        <Style x:Key="ModernCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" 
                                      Opacity="0.3" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Rounded Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" 
                                                  Opacity="0.2" BlurRadius="4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Sidebar -->
        <Border Grid.Column="0"
                Background="#FF252525"
                BorderBrush="#FF3A3A3A"
                BorderThickness="0,0,1,0">
            <!-- Use a DockPanel so we can dock the Exit button to the bottom -->
            <DockPanel LastChildFill="True">
                <!-- Bottom‐docked Exit button -->
                <Button Name="ExitButton"
                        Content="🚪 Exit"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="Exit_Click"
                        DockPanel.Dock="Bottom"
                        Margin="0,0,0,10"/>
                
                <!-- All other sidebar items go above -->
                <StackPanel DockPanel.Dock="Top">
                    <!-- Logo/Title -->
                    <Border Background="{StaticResource PrimaryGradient}" Padding="24" Margin="0,0,0,20" CornerRadius="0,0,16,16">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Direction="270" ShadowDepth="4" 
                                              Opacity="0.4" BlurRadius="8"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🎯 KingshotAuto"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Version, StringFormat=v{0}}"
                                       FontSize="12"
                                       Foreground="#FFE0F2F1"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Navigation Buttons -->
                    <Button Name="BotTabButton"
                            Content="🚀 Bot"
                            Style="{StaticResource ActiveSidebarButtonStyle}"
                            Click="BotTab_Click"/>
                    <Button Name="LogsTabButton"
                            Content="📜 Logs"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="LogsTab_Click"/>
                    <Button Name="SettingsTabButton"
                            Content="⚙️ Settings"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="SettingsTab_Click"/>
                    <Button Name="OtherSettingsTabButton"
                            Content="🔧 Other Settings"
                            Style="{StaticResource SidebarButtonStyle}"
                            Click="OtherSettingsTab_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <!-- Main Content Area -->
        <Grid Grid.Column="1" Background="#FF1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Banner Stack Container -->
            <StackPanel Grid.Row="0" Margin="20,20,20,0">
                
                <!-- English Language Warning Banner -->
                <Border Name="EnglishLanguageBanner"
                        Background="#FFFF5722"
                        Visibility="Visible"
                        Margin="0,0,0,10"
                        CornerRadius="8"
                        BorderBrush="#FFFF3D00"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" 
                                          Opacity="0.3" BlurRadius="4"/>
                    </Border.Effect>
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Warning Icon -->
                        <TextBlock Grid.Column="0"
                                   Text="⚠️"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        
                        <!-- Warning Message -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Important: Set Game Language to English"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Bold"/>
                            <TextBlock Text="For the bot to work correctly, please ensure your game language is set to English in the game settings."
                                       Foreground="#FFFFCCBC"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <!-- Don't Show Again Checkbox -->
                        <StackPanel Grid.Column="2" 
                                    VerticalAlignment="Center" 
                                    Orientation="Horizontal"
                                    Margin="0,0,12,0">
                            <CheckBox Name="DontShowLanguageBannerCheckBox"
                                      Foreground="White"
                                      FontSize="11"
                                      VerticalAlignment="Center"
                                      Checked="DontShowLanguageBanner_Checked">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="CheckBox">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Name="CheckBoxBorder"
                                                                Width="14"
                                                                Height="14"
                                                                Background="Transparent"
                                                                BorderBrush="White"
                                                                BorderThickness="1"
                                                                CornerRadius="2"
                                                                Margin="0,0,6,0">
                                                            <TextBlock Name="CheckMark"
                                                                       Text="✓"
                                                                       Foreground="White"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="Collapsed"/>
                                                        </Border>
                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                          VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="White"/>
                                                            <Setter TargetName="CheckMark" Property="Foreground" Value="#FFFF5722"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CheckBoxBorder" Property="Background" Value="#33FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </CheckBox.Style>
                                Don't show again
                            </CheckBox>
                        </StackPanel>
                        
                        <!-- Close Button -->
                        <Button Grid.Column="3"
                                Name="CloseLanguageBannerButton"
                                Content="✕"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Width="24"
                                Height="24"
                                FontSize="12"
                                Cursor="Hand"
                                Click="CloseLanguageBanner_Click"
                                ToolTip="Dismiss this warning">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="12">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
                
            </StackPanel>
            
            <!-- Main Content Container -->
            <Grid Grid.Row="1">
            
            <!-- Bot Tab Content -->
            <Grid Name="BotTabContent" Visibility="Visible">
                <!-- Task dashboard: cycle controls, characters, and per task the last/next run and a play button -->
                <views:TaskDashboardView DataContext="{Binding ViewModel.Dashboard}"/>
            </Grid>
            
            <!-- Logs Tab Content -->
            <Grid Name="LogsTabContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Style="{StaticResource ModernCardStyle}"
                        Margin="20,20,20,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="📜 Bot Logs"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                            <Border Background="{StaticResource PrimaryGradient}"
                                    CornerRadius="16"
                                    Padding="8,4"
                                    Margin="15,0,0,0">
                                <TextBlock Text="Real-time"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                        
                        <ScrollViewer Grid.Row="1" 
                                      VerticalScrollBarVisibility="Auto"
                                      MaxHeight="600"
                                      Background="#FF1A1A1A">
                            <TextBox x:Name="LogTextBox"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     Foreground="#FFE0E0E0"
                                     BorderThickness="0"
                                     Padding="10"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Settings Tab Content -->
            <Grid Name="SettingsTabContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Settings Header -->
                <Border Grid.Row="0"
                        Style="{StaticResource ModernCardStyle}"
                        Margin="20,20,20,10">
                    <StackPanel>
                        <TextBlock Text="Bot Settings"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Configure your bot settings and account management"
                                   FontSize="14"
                                   Foreground="#FFB0B0B0"/>
                    </StackPanel>
                </Border>
                
                <!-- Config Editor -->
                <Border Grid.Row="1"
                        Style="{StaticResource ModernCardStyle}"
                        Margin="20,10,20,20">
                    <views:ConfigEditorViewImproved x:Name="ConfigEditorView"/>
                </Border>
            </Grid>
            
            <!-- Other Settings Tab Content -->
            <Grid Name="OtherSettingsTabContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Other Settings Header -->
                <Border Grid.Row="0"
                        Style="{StaticResource ModernCardStyle}"
                        Margin="20,20,20,10">
                    <StackPanel>
                        <TextBlock Text="Other Settings"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Additional configuration options"
                                   FontSize="14"
                                   Foreground="#FFB0B0B0"/>
                    </StackPanel>
                </Border>
                
                <!-- Other Settings Content -->
                <Border Grid.Row="1"
                        Style="{StaticResource ModernCardStyle}"
                        Margin="20,10,20,20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,10">
                            
                            <!-- LDPlayer Path Section -->
                            <StackPanel Margin="0,0,0,30">
                                <TextBlock Text="🎮 LDPlayer Installation Path"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,8"/>
                                
                                <TextBlock Text="Manually specify the LDPlayer installation directory if auto-detection fails."
                                           FontSize="12"
                                           Foreground="#FFB0B0B0"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>
                                
                                <!-- Current Path Display -->
                                <Border Background="#FF2A2A2A"
                                        BorderBrush="#FF444444"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Current Detection Result:"
                                                   FontSize="11"
                                                   Foreground="#FF888888"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Name="CurrentLDPlayerPathText"
                                                   Text="Auto-detecting..."
                                                   FontSize="12"
                                                   Foreground="#FF4CAF50"
                                                   FontFamily="Consolas"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Manual Path Input -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox Name="ManualLDPlayerPathTextBox"
                                             Grid.Column="0"
                                             Height="35"
                                             Padding="10,8"
                                             FontSize="12"
                                             Background="#FF383838"
                                             Foreground="White"
                                             BorderBrush="#FF666666"
                                             BorderThickness="1"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Enter LDPlayer installation folder path... (e.g., C:\LDPlayer\LDPlayer9)"/>
                                    
                                    <Button Name="BrowseLDPlayerPathButton"
                                            Grid.Column="1"
                                            Content="📁 Browse"
                                            Width="100"
                                            Height="35"
                                            Background="#FF0D7377"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="10,0,0,0"
                                            Style="{StaticResource RoundedButtonStyle}"
                                            Click="BrowseLDPlayerPath_Click"/>
                                </Grid>
                                
                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Name="SetLDPlayerPathButton"
                                            Content="✅ Set Path" 
                                            Width="100"
                                            Height="32"
                                            Background="#FF4CAF50"
                                            Foreground="White"
                                            Style="{StaticResource RoundedButtonStyle}"
                                            Margin="0,0,10,0"
                                            Click="SetLDPlayerPath_Click"/>
                                    
                                    <Button Name="TestLDPlayerPathButton"
                                            Content="🔍 Test Path"
                                            Width="100"
                                            Height="32"
                                            Background="#FFFF9800"
                                            Foreground="White"
                                            Style="{StaticResource RoundedButtonStyle}"
                                            Margin="0,0,10,0"
                                            Click="TestLDPlayerPath_Click"/>
                                    
                                    <Button Name="ResetLDPlayerPathButton"
                                            Content="🔄 Reset"
                                            Width="80"
                                            Height="32"
                                            Background="#FFFF5722"
                                            Foreground="White"
                                            Style="{StaticResource RoundedButtonStyle}"
                                            Click="ResetLDPlayerPath_Click"/>
                                </StackPanel>
                                
                                <!-- Status Messages -->
                                <Border Name="LDPlayerPathStatusBorder"
                                        Background="#FF2A2A2A"
                                        BorderBrush="#FF444444"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10"
                                        Visibility="Collapsed">
                                    <TextBlock Name="LDPlayerPathStatusText"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                            
                            <!-- Future Settings Section -->
                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Text="⚙️ Additional Settings"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Margin="0,0,0,8"/>
                                
                                <TextBlock Text="More configuration options will be added here in future updates."
                                           FontSize="12"
                                           Foreground="#FFB0B0B0"
                                           Margin="0,0,0,10"/>
                            </StackPanel>
                            
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
            
            </Grid> <!-- Closing Main Content Container -->
        </Grid>
    </Grid>
</Window>
