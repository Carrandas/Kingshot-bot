<UserControl x:Class="Bot.GUI.Views.TaskDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FF2D2D2D"/>
        <SolidColorBrush x:Key="RowBrush" Color="#FF333333"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FFAAAAAA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF14A085"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FF4CAF50"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bg" Background="{StaticResource CardBrush}" CornerRadius="8,8,0,0" Padding="18,8" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cycle controls and the next run -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="▶  Run on schedule" Background="#FF4CAF50" Style="{StaticResource ActionButton}"
                            Command="{Binding RunOnScheduleCommand}"
                            ToolTip="Run a cycle now, then again after every cycle wait (Settings: min-max minutes)"/>
                    <Button Content="①  Run once" Background="#FF0D7377" Style="{StaticResource ActionButton}"
                            Command="{Binding RunOnceCommand}"
                            ToolTip="Run the task list once on every enabled character, then stop"/>
                    <Button Content="🎮  Start Kingshot" Background="#FF1976D2" Style="{StaticResource ActionButton}"
                            Command="{Binding StartKingshotCommand}"
                            ToolTip="Start LDPlayer with the bot's settings and launch Kingshot (no tasks run)"/>
                    <Button Content="{Binding DataContext.ViewModel.PauseResumeButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="#FFFF9800" Style="{StaticResource ActionButton}"
                            ToolTip="Pause holds the bot at its next tap; Resume carries on from there"
                            Command="{Binding DataContext.ViewModel.PauseResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button Content="⏹  Stop" Background="#FFD32F2F" Style="{StaticResource ActionButton}"
                            Command="{Binding DataContext.ViewModel.StopCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
                <TextBlock Text="{Binding CycleStatus}" Foreground="White" FontSize="18" FontWeight="SemiBold"
                           Margin="0,16,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ActiveCharacterText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Characters -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Characters" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ComboBox DockPanel.Dock="Top" Margin="0,0,0,10"
                              ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="AccountName"
                              Visibility="{Binding ShowAccountPicker, Converter={StaticResource BoolToVisibility}}"/>
                    <Button DockPanel.Dock="Bottom" Content="🔍  Scan characters" Background="#FF0D7377" Height="34" Margin="0,10,0,0"
                            Style="{StaticResource ActionButton}" Command="{Binding ScanCharactersCommand}"
                            ToolTip="Start the game and read the Characters screen once"/>
                    <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Unticked characters are left out of the cycle."/>
                    <CheckBox DockPanel.Dock="Bottom" IsChecked="{Binding SwitchCharacters}" Margin="0,10,0,0"
                              ToolTip="Change Account: the cycle runs the task list on every ticked character. Off: only on the character that is active in the game.">
                        <TextBlock Text="Switch characters each cycle" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                    </CheckBox>
                    <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bg" Background="{StaticResource RowBrush}" CornerRadius="8" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Entry.Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              Visibility="{Binding HasEntry, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="Run the cycle on this character"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="0,8,0,0">
            <TabItem Header="Cycle">
            <!-- Tasks of the selected character -->
            <Border Style="{StaticResource CardStyle}">
                <DockPanel Grid.IsSharedSizeScope="True">
                    <Grid DockPanel.Dock="Top" Margin="10,0,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ON" Style="{StaticResource HeaderText}" ToolTip="In the cycle's task list (all characters)"/>
                        <TextBlock Grid.Column="1" Text="RUN" Style="{StaticResource HeaderText}"/>
                        <TextBlock Grid.Column="2" Text="TASK" Style="{StaticResource HeaderText}"/>
                        <TextBlock Grid.Column="3" Text="LAST RUN" Style="{StaticResource HeaderText}"/>
                        <TextBlock Grid.Column="4" Text="NEXT RUN" Style="{StaticResource HeaderText}"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TaskList" ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="10,6" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource RowBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunningNow}" Value="True">
                                                        <Setter Property="Background" Value="#FF1E4D45"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding LastRunTooltip}">
                                                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FF666666"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LastRunState}" Value="ok">
                                                                    <Setter Property="Fill" Value="#FF4CAF50"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LastRunState}" Value="failed">
                                                                    <Setter Property="Fill" Value="#FFE57373"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding LastRunText}" Foreground="#FFCCCCCC" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="4" Text="{Binding NextRunText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding NextRunText}" Foreground="#FFCCCCCC" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="▶" HorizontalAlignment="Left" Style="{StaticResource PlayButton}"
                                                    Command="{Binding DataContext.RunTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Run only this task on the selected character now (disabled while the bot runs)"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            </TabItem>

            <!-- Castle Battle: settings and the state of each character -->
            <TabItem Header="Castle Battle">
                <Border Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <Button Content="⚔  Castle Battle" Background="#FF8E44AD" Style="{StaticResource ActionButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,12"
                                    Command="{Binding StartCastleBattleCommand}"
                                    ToolTip="Stop the cycle and join castle battle rallies on every ticked character until Stop"/>
                            <TextBlock Text="{Binding BattleStatusText}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <Grid DataContext="{Binding BattleSettings}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFCCCCCC"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Width" Value="44"/>
                                        <Setter Property="Height" Value="26"/>
                                        <Setter Property="Margin" Value="0,0,12,0"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </Grid.Resources>

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="TEAM" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Offensive" ToolTip="Red Rally rows: attacking a tower or castle"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Width="54" HorizontalAlignment="Left" Margin="0,4"
                                          ItemsSource="{Binding DataContext.TeamOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding OffensiveTeam}" ToolTip="Team flag at the top of the deploy screen; the flag keeps its troops and ratio"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Defensive" ToolTip="Blue Def. Lineup rows: defending a tower or castle we hold"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Width="54" HorizontalAlignment="Left" Margin="0,4"
                                          ItemsSource="{Binding DataContext.TeamOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding DefensiveTeam}" ToolTip="Team flag at the top of the deploy screen; the flag keeps its troops and ratio"/>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Heal amount" ToolTip="Starting heal batch; each character then keeps its own (BATCH column)"/>
                                    <TextBox Width="56" Text="{Binding HealAmount, UpdateSourceTrigger=PropertyChanged}" ToolTip="Troops per Heal tap"/>
                                    <TextBlock Text="Reinforce every"/>
                                    <TextBox Text="{Binding ReinforceIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="min    Stop after"/>
                                    <TextBox Text="{Binding MaxHours, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="hours"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="10,20,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CHARACTER" Style="{StaticResource HeaderText}"/>
                                <TextBlock Grid.Column="1" Text="STATE" Style="{StaticResource HeaderText}"/>
                                <TextBlock Grid.Column="2" Text="JOINED" Style="{StaticResource HeaderText}" ToolTip="Rallies joined this battle"/>
                                <TextBlock Grid.Column="3" Text="HELPS" Style="{StaticResource HeaderText}" ToolTip="Heal > Help rounds this battle"/>
                                <TextBlock Grid.Column="4" Text="BATCH" Style="{StaticResource HeaderText}" ToolTip="Heal batch: troops per Heal, learned per character"/>
                                <TextBlock Grid.Column="5" Text="UPDATED" Style="{StaticResource HeaderText}"/>
                            </Grid>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding BattleRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource RowBrush}" Margin="0,0,0,4" Padding="10,8" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Character}" Foreground="White" FontSize="13"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding State}" Foreground="White" FontSize="13"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Joined}" Foreground="#FFCCCCCC" FontSize="12"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Heals}" Foreground="#FFCCCCCC" FontSize="12"/>
                                            <TextBlock Grid.Column="4" Text="{Binding HealBatch}" Foreground="#FFCCCCCC" FontSize="12"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Updated}" Foreground="#FFCCCCCC" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- Bear Hunt: the switch, when the next bear is, the flags and the state of each character -->
            <TabItem Header="Bear Hunt">
                <Border Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <Button Content="🐻  Bear Hunt" Background="#FF8D6E63" Style="{StaticResource ActionButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,12"
                                    Command="{Binding StartBearHuntCommand}"
                                    ToolTip="Stop the cycle and do the bear now: the saved bear when it is on, else a bear starting now"/>
                            <CheckBox IsChecked="{Binding BearHuntEnabled}" Margin="0,0,0,8"
                                      ToolTip="The Bear Hunt task's cycle switch: the cycle reads the next bear once a day, and the bot runs the bear by itself">
                                <TextBlock Text="Bear Hunt on" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            </CheckBox>
                            <TextBlock Text="{Binding BearStatusText}" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding NextBearText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,14"/>

                            <StackPanel DataContext="{Binding BearSettings}">
                                <StackPanel.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFCCCCCC"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                    </Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Width" Value="44"/>
                                        <Setter Property="Height" Value="26"/>
                                        <Setter Property="Margin" Value="0,0,14,0"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Width" Value="54"/>
                                        <Setter Property="Margin" Value="0,0,14,0"/>
                                    </Style>
                                </StackPanel.Resources>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Our trap"/>
                                    <ComboBox ItemsSource="{Binding DataContext.TrapOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Trap}" ToolTip="The Task List shows Bear Hunt - Trap 1 and Trap 2: the one of our alliance"/>
                                    <TextBlock Text="Next bear (UTC)"/>
                                    <TextBox Width="130" Text="{Binding NextBearUtcText, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="yyyy-MM-dd HH:mm in UTC. Filled by the cycle from the Task List (tap the UTC banner on the map); type it to set it by hand"/>
                                    <TextBlock Text="First character"/>
                                    <ComboBox Width="120" IsEditable="True"
                                              ItemsSource="{Binding DataContext.CharacterNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Text="{Binding FirstCharacter, UpdateSourceTrigger=LostFocus}"
                                              ToolTip="Sends its rally first; the others follow. Empty: the roster's order"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Own rally flag"/>
                                    <ComboBox ItemsSource="{Binding DataContext.TeamOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding OwnTeam}" ToolTip="Set this flag once in the game: 5% infantry, 10% cavalry, 85% archers"/>
                                    <TextBlock Text="Join flag"/>
                                    <ComboBox ItemsSource="{Binding DataContext.TeamOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding JoinTeam}" ToolTip="Team flag for joining the alliance's bear rallies"/>
                                    <TextBlock Text="Join up to"/>
                                    <TextBox Text="{Binding MaxJoins, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rallies joined at once per character: the top ones of the War list"/>
                                    <TextBlock Text="Own rally away (s)"/>
                                    <TextBox Text="{Binding RallyRoundSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="5 min rally + the walk there and back; the next own rally goes when this has passed"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Gear swap" FontWeight="SemiBold" Foreground="White"
                                                   ToolTip="Per character: before the bear the gear moves from the normal hero to the bear hero (Unequip All, then Quick Equip), after the bear it moves back"/>
                                        <Button Content="+ Add" Padding="8,1" Margin="6,0,0,0"
                                                Command="{Binding DataContext.AddGearSwapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding GearSwaps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Swap the gear for this character"/>
                                                    <ComboBox Width="120" IsEditable="True"
                                                              ItemsSource="{Binding DataContext.CharacterNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              Text="{Binding Character, UpdateSourceTrigger=LostFocus}"/>
                                                    <TextBlock Text="normal"/>
                                                    <ComboBox Width="110" IsEditable="True"
                                                              ItemsSource="{Binding DataContext.HeroNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              Text="{Binding NormalHero, UpdateSourceTrigger=LostFocus}" ToolTip="The hero that wears the gear normally"/>
                                                    <TextBlock Text="bear"/>
                                                    <ComboBox Width="110" IsEditable="True"
                                                              ItemsSource="{Binding DataContext.HeroNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              Text="{Binding BearHero, UpdateSourceTrigger=LostFocus}" ToolTip="The hero that wears the gear during the bear"/>
                                                    <Button Content="✕" Padding="6,0" ToolTip="Remove"
                                                            Command="{Binding DataContext.RemoveGearSwapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                           Text="Beta: the bear icon and the trap's rally screens are not calibrated yet. Until then the own rally saves screenshots under logs/screenshots/bearhunt/ and skips; joining, Auto-Join Stop and the recall of gatherers work. No own rally after the start + 24:30."/>
                            </StackPanel>

                            <Grid Margin="10,20,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CHARACTER" Style="{StaticResource HeaderText}"/>
                                <TextBlock Grid.Column="1" Text="STATE" Style="{StaticResource HeaderText}"/>
                                <TextBlock Grid.Column="2" Text="OWN" Style="{StaticResource HeaderText}" ToolTip="Own rallies sent this bear"/>
                                <TextBlock Grid.Column="3" Text="JOINED" Style="{StaticResource HeaderText}" ToolTip="Rallies joined this bear"/>
                                <TextBlock Grid.Column="4" Text="UPDATED" Style="{StaticResource HeaderText}"/>
                            </Grid>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding BearRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource RowBrush}" Margin="0,0,0,4" Padding="10,8" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Character}" Foreground="White" FontSize="13"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding State}" Foreground="White" FontSize="13"/>
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Own}" Foreground="#FFCCCCCC" FontSize="12"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Joined}" Foreground="#FFCCCCCC" FontSize="12"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Updated}" Foreground="#FFCCCCCC" FontSize="12"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
